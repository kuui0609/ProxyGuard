# 换行符与文本属性统一规则
# 目的：无论谁在什么系统上克隆，检出的文件都保持一致，不会因为换行符产生无意义的 diff。

* text=auto

# Windows 脚本：必须 CRLF（cmd.exe / Windows PowerShell 的原生习惯）
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# 文档与配置：LF
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# 没有扩展名的文本文件也统一用 LF（否则会按平台默认值转换）
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf

# 二进制文件：不要做任何转换
*.zip binary
*.png binary
*.ico binary
*.gif binary
